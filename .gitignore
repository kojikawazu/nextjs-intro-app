# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# playwright
/test-results/
/playwright-report/
# Playwright MCP がブラウザ検証時に出力するスナップショット。
# 取得したページ本文（本番データを含む）が入るため、コミットしない。
/.playwright-mcp/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
# GCP 等のサービスアカウント鍵。区切りが service-account / service_account / serviceAccount と
# 揺れるため全形を並べる。検出側（scripts/secret-scan.sh）と対象を揃えること（issue #160）
*-key.json
service-account*.json
service_account*.json
serviceAccount*.json
credentials.json
# GCP コンソールでダウンロードした SA キーの既定名 <project-id>-<12 桁の 16 進>.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files（テンプレートの .env.example だけ追跡する）
# 以前は .env*.local のみで、.env / .env.production が除外されていなかった（issue #155 で是正）
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Design files
design/

# Terraform files
# state と tfvars は共有 GCS バケットの nextjs-intro-app/ に置く（docs/09 §7.5）
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl は除外しない（provider のバージョンとハッシュを固定するためコミットする。issue #158）
# tfvars は名前を問わず秘密を含みうる（*.auto.tfvars / 環境別ファイル等）
*.tfvars
*.tfvars.json
# plan ファイル（-out）には変数の値がシークレット込みで入る
*.tfplan
tfplan
crash.log
crash.*.log

private/
sample.json