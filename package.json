{
    "name": "portfolio-template",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:md": "markdownlint-cli2",
        "lint:md:fix": "markdownlint-cli2 --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:it": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "playwright test",
        "audit:prod": "pnpm audit --prod",
        "audit:ci": "pnpm audit --prod --audit-level critical"
    },
    "dependencies": {
        "@google-cloud/storage": "^8.2.0",
        "@hookform/resolvers": "^5.9.1",
        "clsx": "^2.1.1",
        "next": "15.5.25",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.89.0",
        "resend": "^6.32.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "24.13.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "^4.1.11",
        "autoprefixer": "10.6.1",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.5",
        "eslint-plugin-jsdoc": "^64.5.4",
        "jsdom": "^29.1.1",
        "markdownlint-cli2": "^0.23.3",
        "msw": "^2.15.0",
        "postcss": "8.5.29",
        "prettier": "^3.9.9",
        "tailwindcss": "4.3.3",
        "testcontainers": "^12.2.0",
        "typescript": "5.5.2",
        "typescript-eslint": "^8.71.1",
        "vitest": "^4.1.11"
    },
    "pnpm": {
        "overrides": {
            "next>postcss": "^8.5.29",
            "gaxios>uuid": "^11.1.1",
            "smol-toml": "^1.9.0",
            "katex": "^0.18.2",
            "postcss-selector-parser": "^7.1.6"
        }
    }
}
