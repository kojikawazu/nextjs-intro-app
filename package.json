{
    "name": "portfolio-template",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:md": "markdownlint-cli2",
        "lint:md:fix": "markdownlint-cli2 --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:it": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "playwright test",
        "audit:prod": "pnpm audit --prod",
        "audit:ci": "pnpm audit --prod --audit-level critical"
    },
    "dependencies": {
        "@google-cloud/storage": "^8.4.0",
        "@hookform/resolvers": "^5.9.2",
        "clsx": "^2.1.1",
        "next": "15.5.28",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.90.0",
        "resend": "^6.34.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "^4.1.12",
        "autoprefixer": "10.6.1",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.2",
        "eslint-plugin-jsdoc": "^65.4.0",
        "jsdom": "^30.1.3",
        "markdownlint-cli2": "^0.24.0",
        "msw": "^2.15.0",
        "postcss": "8.5.31",
        "prettier": "^3.9.10",
        "tailwindcss": "3.4.19",
        "testcontainers": "^12.2.1",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^4.1.12"
    },
    "pnpm": {
        "overrides": {
            "next>postcss": "^8.5.29",
            "katex": "^0.18.2",
            "postcss-selector-parser": "^7.1.6"
        }
    }
}
