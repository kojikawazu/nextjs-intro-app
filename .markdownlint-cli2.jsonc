{
    // Markdown の静的検査。取捨選択の判断根拠は docs/10「静的解析」を参照。
    //
    // 無効化しているルールは「本プロジェクトの書き方と正面から衝突し、
    // 機械的に従うと可読性が落ちるもの」に限る。件数が多いという理由だけで
    // 無効化しない（それでは lint が形骸化する）。
    "config": {
        // テーブルのパイプ前後の空白スタイル。日本語の横長テーブルが多く
        // 1,966 件と突出する。Prettier は Markdown を対象外にしている
        // （.prettierignore）ため整形の担い手も居らず、手作業で揃える価値がない。
        "MD060": false,

        // 1 行 80 文字制限。日本語の説明文では実質的に守れない（508 件）。
        "MD013": false,

        // 箇条書きのインデント幅（442 件）。既存文書は 4 スペースで統一されており、
        // 既定の 2 スペースへ揃える利得が無い。
        "MD007": false,

        // 太字を見出し代わりに使う記法（13 件）。`**レスポンスヘッダー**` のように
        // 「目次には出したくないラベル」として意図的に使っている。見出しへ昇格すると
        // 目次が肥大し、かえってアンカーの不整合（MD051）を誘発する。
        "MD036": false,

        // 見出しの重複。文書内で一意である必要はなく、同一階層の兄弟間でだけ
        // 重複を禁じる。「#### 実装」「#### 検証」のような節が別セクションに
        // 現れるのは正常なため。
        "MD024": { "siblings_only": true },
    },
    "globs": ["**/*.md"],
    "ignores": ["node_modules/**"],
}
